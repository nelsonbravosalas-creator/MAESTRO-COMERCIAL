# Variables para docker-compose.yml (Postgres local + pgAdmin de desarrollo).
# Copiar a ".env" en la raíz del proyecto; ese archivo NUNCA se versiona.
POSTGRES_USER=bravocrm_user
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=bravocrm

PGADMIN_DEFAULT_EMAIL=admin@local.test
PGADMIN_DEFAULT_PASSWORD=change-this-local-password
