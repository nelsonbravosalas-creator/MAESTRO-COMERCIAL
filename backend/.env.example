# Database
# For Neon: postgresql://user:password@[project].neon.tech/bravocrm
# For local PostgreSQL: postgresql://user:password@localhost:5432/bravocrm
DATABASE_URL=postgresql://user:password@localhost:5432/bravocrm

# JWT Configuration
# Generar con: openssl rand -base64 48   (mínimo 32 caracteres, el arranque falla si no cumple)
JWT_SECRET=change-this-to-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=30d

# Admin setup (POST /api/admin/setup) - crea/promueve un usuario a admin.
# Dejar SIN definir deshabilita el endpoint (responde 503). Si se define, mínimo 32 caracteres.
ADMIN_SETUP_SECRET=change-this-to-a-long-random-secret-of-at-least-32-characters

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# CORS: lista de orígenes permitidos separados por coma (sin espacios extra, sin barra final)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000

# Observabilidad (opcional). Sin definir, captureException() es un no-op.
# SENTRY_DSN=

# Correo transaccional (opcional). Sin definir, el mailer cae a un Noop que
# solo loguea — ver docs/EMAIL_SETUP.md antes de activar en producción.
#
# Opción 1 — SMTP con una cuenta de correo existente (sin dominio propio).
# SMTP_USER/SMTP_PASSWORD tienen prioridad sobre RESEND_API_KEY si ambos
# están presentes. SMTP_PASSWORD es una "contraseña de aplicación" de Google,
# nunca la contraseña real de la cuenta.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tu-cuenta@gmail.com
# SMTP_PASSWORD=contraseña-de-aplicacion-de-16-caracteres
#
# Opción 2 — Resend con dominio propio verificado.
# RESEND_API_KEY=
# MAIL_FROM="BravoCRM <no-reply@tudominio.cl>"

# URL pública del frontend, usada para armar el link de reset-password.
FRONTEND_PUBLIC_URL=http://localhost:5173

# npm run seed (backend/src/db/seed.ts) — opcional. Sin estas variables el script
# no crea ningún usuario. Password mínimo 8 caracteres.
# SEED_ADMIN_EMAIL=tu@correo.cl
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=
# SEED_MANAGER_EMAIL=
# SEED_MANAGER_PASSWORD=
# SEED_MANAGER_NAME=

# Optional: Neon specific
# NEON_API_KEY=your-neon-api-key-if-needed

# Chatbot de cotizaciones (POST /api/chatbot). Sin GEMINI_API_KEY el endpoint
# responde 503 explicando el motivo en vez de fallar a ciegas. Key gratis sin
# tarjeta en https://aistudio.google.com/apikey — ver docs/RIESGOS_ACEPTADOS.md
# para la minimización de datos (nunca se envía nombre/RUT/contacto real del
# cliente al LLM).
# GEMINI_API_KEY=
CHATBOT_PARSE_MODEL=gemini-3.6-flash
CHATBOT_PRICE_MODEL=gemini-3.6-flash
# Modo agente comercial multipaso (Fases A-B). Por defecto false (usa parser de un solo intent).
# AGENT_MODE=true
AGENT_MODEL=gemini-3.6-flash
# OmniRoute AI Gateway (opcional para desarrollo local o delegación de modelos pesados).
# Si está configurado, delega a OmniRoute (http://127.0.0.1:20128/v1) con fallback a Gemini.
# OMNIROUTE_URL=http://127.0.0.1:20128/v1
# OMNIROUTE_API_KEY=sk-ba367afc7ae8d0dd-fc3248-498819f8
# OMNIROUTE_MODEL=gemini/gemini-3.6-flash
