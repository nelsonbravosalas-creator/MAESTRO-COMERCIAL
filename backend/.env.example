# Database
# For Neon: postgresql://user:password@[project].neon.tech/bravocrm
# For local PostgreSQL: postgresql://user:password@localhost:5432/bravocrm
DATABASE_URL=postgresql://user:password@localhost:5432/bravocrm

# JWT Configuration
# Generar con: openssl rand -base64 48   (mínimo 32 caracteres, el arranque falla si no cumple)
JWT_SECRET=change-this-to-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=30d

# Admin setup (POST /api/admin/setup) - crea/promueve un usuario a admin.
# Dejar SIN definir deshabilita el endpoint (responde 503). Si se define, mínimo 32 caracteres.
ADMIN_SETUP_SECRET=change-this-to-a-long-random-secret-of-at-least-32-characters

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# CORS: lista de orígenes permitidos separados por coma (sin espacios extra, sin barra final)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000

# Observabilidad (opcional). Sin definir, captureException() es un no-op.
# SENTRY_DSN=

# Correo transaccional (opcional). Sin definir, el mailer cae a un Noop que
# solo loguea — ver docs/EMAIL_SETUP.md antes de activar en producción.
# RESEND_API_KEY=
# MAIL_FROM="BravoCRM <no-reply@tudominio.cl>"

# URL pública del frontend, usada para armar el link de reset-password.
FRONTEND_PUBLIC_URL=http://localhost:5173

# npm run seed (backend/src/db/seed.ts) — opcional. Sin estas variables el script
# no crea ningún usuario. Password mínimo 8 caracteres.
# SEED_ADMIN_EMAIL=tu@correo.cl
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=
# SEED_MANAGER_EMAIL=
# SEED_MANAGER_PASSWORD=
# SEED_MANAGER_NAME=

# Optional: Neon specific
# NEON_API_KEY=your-neon-api-key-if-needed
