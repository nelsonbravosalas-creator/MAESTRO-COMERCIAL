{
  "name": "bravocrm-backend",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:json": "tsx watch src/server-dev.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "seed": "tsx src/db/seed.ts",
    "cleanup:sessions": "tsx src/scripts/cleanupSessions.ts",
    "report:weekly": "tsx src/scripts/weeklyCommercialSummary.ts",
    "migrate": "node-pg-migrate -m src/db/migrations",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down 1",
    "migrate:create": "npm run migrate -- create --",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@sentry/node": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.3.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "winston": "^3.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
