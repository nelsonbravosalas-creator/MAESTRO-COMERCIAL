{
  "name": "bravocrm-backend",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:json": "tsx watch src/server-dev.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "seed": "tsx src/db/seed.ts",
    "cleanup:sessions": "tsx src/scripts/cleanupSessions.ts",
    "migrate": "node-pg-migrate -m src/db/migrations",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down 1",
    "migrate:create": "npm run migrate -- create --",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@sentry/node": "^10.70.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.3.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "winston": "^3.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
